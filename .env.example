PANEL_VERSION=v5.2.1
NODE_VERSION=v0.5.3

TZ=Europe/Berlin

XUI_DOMAIN=xui-admin.example.com
XUI_BASE_PATH=/console-change-me-random/

UVICORN_PORT=8000
PANEL_IP=172.22.0.50
NODE_IP=172.22.0.51

EDGE_DOMAIN=edge.example.com
EDGE_PORT=10086
INBOUND_WS_PATH=/chat/sync

SUDO_USERNAME=change_me
SUDO_PASSWORD=change_me
NODE_API_KEY=00000000-0000-0000-0000-000000000000

PG_DB_HOST=postgres
PG_DB_PORT=5432
PG_DB_NAME=pasarguard
PG_DB_USER=pasarguard
PG_DB_PASSWORD=change_me

# GitHub Actions Cloudflare check (repo vars/secrets, not used by compose)
# vars: CLOUDFLARE_ZONE_ID, XUI_DOMAIN, EDGE_DOMAIN, INBOUND_WS_PATH
# secrets: CLOUDFLARE_API_TOKEN (Zone DNS Read + Zone Settings Read), XUI_BASE_PATH
#
# GitHub Actions CD (workflow_dispatch)
# vars: DEPLOY_SSH_PORT (optional, default 22)
# secrets: DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, DEPLOY_PATH
# health retries (workflow env): SMOKE_ATTEMPTS=8, SMOKE_DELAY_SECONDS=10
