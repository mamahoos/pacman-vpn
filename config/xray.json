{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "VLESS_WS",
      "listen": "0.0.0.0",
      "port": 10086,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "acceptProxyProtocol": false,
          "path": "/chat/sync",
          "host": "",
          "headers": {}
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "routeOnly": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "DIRECT",
      "protocol": "freedom"
    },
    {
      "tag": "WARP",
      "protocol": "socks",
      "targetStrategy": "ForceIPv4",
      "settings": {
        "servers": [
          {
            "address": "warp",
            "port": 1080
          }
        ]
      }
    },
    {
      "tag": "BLOCK",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "ForceIPv6",
    "rules": [
      {
        "type": "field",
        "outboundTag": "WARP",
        "domain": [
          "domain:gemini.google.com",
          "domain:google.com",
          "domain:googleapis.com",
          "domain:gstatic.com",
          "domain:aistudio.google.com",
          "domain:generativelanguage.googleapis.com",
          "domain:accounts.google.com",
          "domain:googleusercontent.com",
          "domain:openai.com",
          "domain:chatgpt.com",
          "domain:oaistatic.com",
          "domain:oaiusercontent.com",
          "domain:anthropic.com",
          "domain:claude.ai",
          "domain:githubcopilot.com",
          "domain:copilot.microsoft.com"
        ]
      }
    ]
  }
}
